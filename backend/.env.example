# ─────────────────────────────────────────────────────────────────────────────
# .env  –  Environment variables for Sarathi-X backend
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development           # 'development' | 'production'
FLASK_DEBUG=True                # Set False in production
SECRET_KEY=sarathi_x_super_secret_key_change_me

# JWT
JWT_SECRET_KEY=sarathi_x_jwt_secret_change_me_in_prod
JWT_ACCESS_TOKEN_EXPIRES=3600   # Access token TTL in seconds (1 hour)
JWT_REFRESH_TOKEN_EXPIRES=604800 # Refresh token TTL in seconds (7 days)

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sarathi_x
DB_USER=root
DB_PASSWORD=your_mysql_password

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
